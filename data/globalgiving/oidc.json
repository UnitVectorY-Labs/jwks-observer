{
  "authorization_endpoint": "https://accounts.globalgiving.org/oidc/authorize",
  "claims_supported": [
    "sub",
    "email",
    "name",
    "gg_uuid",
    "cognito_sub",
    "legacy_user_id",
    "iss",
    "aud",
    "exp",
    "iat",
    "nonce",
    "at_hash"
  ],
  "code_challenge_methods_supported": [
